<!-- SEO Meta Tags -->
{{!-- No hardcoded canonical/og:url: a single site-wide canonical tells search
engines every page is a duplicate of the homepage and drops it from the index. --}}
<meta name="author" content="Piotr Kodzis">

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:site_name" content="hcpctl">

<!-- Twitter -->
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">

